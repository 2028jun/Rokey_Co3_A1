  <version>0.0.0</version>
  <description>서빙 로봇의 로봇팔/자율주행/비전 작업을 조율하는 Manager(컨트롤) 노드</description>
  <maintainer email="rokey@todo.todo">rokey</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>serving_robot_interfaces</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>hand_safety</exec_depend>
  <exec_depend>nav_robot_missions</exec_depend>
  <exec_depend>two_wheel_rails</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
