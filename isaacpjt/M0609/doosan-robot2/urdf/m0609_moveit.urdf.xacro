		<link name="tool0"/>
		<joint name="joint_6-tool0" type="fixed">
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<parent link="link_6"/>
			<child link="tool0"/>
		</joint>

		<!-- Detailed OnRobot RG2 model. rg2_finger_joint is the actuated joint;
		     the remaining linkage joints follow it through URDF mimic tags. -->
		<material name="rg2_silver"><color rgba="0.68 0.69 0.68 1"/></material>
		<material name="rg2_blue"><color rgba="0.216 0.592 0.812 1"/></material>

		<xacro:macro name="rg2_mesh_link" params="name mesh visual_xyz:='0 0 0' color:='rg2_silver'">
			<link name="${name}">
				<!-- Every imported RG2 link needs finite mass properties for a
				     stable PhysX articulation. -->
				<inertial>
					<origin xyz="0 0 0" rpy="0 0 0"/>
					<mass value="0.10"/>
					<inertia ixx="0.0001" ixy="0" ixz="0"
					         iyy="0.0001" iyz="0" izz="0.0001"/>
				</inertial>
				<visual>
					<origin xyz="${visual_xyz}" rpy="0 0 0"/>
					<geometry>
						<mesh filename="package://m0609_isaac_description/onrobot_rg2/visual/${mesh}.stl" scale="0.001 0.001 0.001"/>
					</geometry>
					<material name="${color}"/>
				</visual>
				<collision>
					<origin xyz="${visual_xyz}" rpy="0 0 0"/>
					<geometry>
						<mesh filename="package://m0609_isaac_description/onrobot_rg2/collision/${mesh}.stl" scale="0.001 0.001 0.001"/>
					</geometry>
				</collision>
			</link>
		</xacro:macro>

		<xacro:rg2_mesh_link name="rg2_quick_changer" mesh="quick_changer" color="rg2_blue"/>
		<xacro:rg2_mesh_link name="rg2_angle_bracket" mesh="angle_bracket" visual_xyz="0 0 -0.00255"/>
		<xacro:rg2_mesh_link name="rg2_base_link" mesh="gripper_body" visual_xyz="0.02705 0 -0.047"/>
		<xacro:rg2_mesh_link name="rg2_left_inner_knuckle" mesh="left_inner_knuckle" visual_xyz="-0.0075 0.009367 -0.139397"/>
		<xacro:rg2_mesh_link name="rg2_right_outer_knuckle" mesh="right_outer_knuckle" visual_xyz="0.017 0.009534 -0.122898"/>
		<xacro:rg2_mesh_link name="rg2_left_outer_knuckle" mesh="left_outer_knuckle" visual_xyz="-0.017 0.009534 -0.122898"/>
		<xacro:rg2_mesh_link name="rg2_left_inner_finger" mesh="left_inner_finger" visual_xyz="-0.056748 0.00475 -0.160866"/>
		<xacro:rg2_mesh_link name="rg2_right_inner_finger" mesh="right_inner_finger" visual_xyz="0.056748 0.00475 -0.160866"/>
		<xacro:rg2_mesh_link name="rg2_right_inner_knuckle" mesh="right_inner_knuckle" visual_xyz="0.0075 0.009367 -0.139397"/>

		<joint name="rg2_quick_changer_joint" type="fixed">
			<parent link="tool0"/>
			<child link="rg2_quick_changer"/>
			<origin xyz="0 0 0" rpy="0 0 0"/>
		</joint>
		<joint name="rg2_angle_bracket_joint" type="fixed">
			<parent link="rg2_quick_changer"/>
			<child link="rg2_angle_bracket"/>
			<origin xyz="0 0 0.00255" rpy="0 0 0"/>
		</joint>
		<joint name="rg2_gripper_body_joint" type="fixed">
			<parent link="rg2_angle_bracket"/>
			<child link="rg2_base_link"/>
			<origin xyz="-0.02705 0 0.04445" rpy="0.0101229097 0 0"/>
		</joint>
		<joint name="rg2_left_inner_knuckle_joint" type="revolute">
			<parent link="rg2_base_link"/>
			<child link="rg2_left_inner_knuckle"/>
			<origin xyz="0.03455 -0.009367 0.092397" rpy="0 0.415388362 0"/>
			<axis xyz="0 0.999949 -0.010122"/>
			<limit effort="50" lower="-1.19" upper="0.01" velocity="2"/>
			<mimic joint="rg2_finger_joint" multiplier="-1" offset="0"/>
		</joint>
		<joint name="rg2_finger_joint" type="revolute">
			<parent link="rg2_base_link"/>
			<child link="rg2_right_outer_knuckle"/>
			<origin xyz="0.01005 -0.009534 0.075898" rpy="0 -0.415388362 0"/>
			<axis xyz="0 0.999949 -0.010122"/>
			<limit effort="50" lower="0" upper="1.18" velocity="2"/>
		</joint>
		<joint name="rg2_left_outer_knuckle_joint" type="revolute">
			<parent link="rg2_base_link"/>
			<child link="rg2_left_outer_knuckle"/>
			<origin xyz="0.04405 -0.009534 0.075898" rpy="0 0.415388362 0"/>
			<axis xyz="0 0.999949 -0.010122"/>
			<limit effort="50" lower="-1.19" upper="0.01" velocity="2"/>
			<mimic joint="rg2_finger_joint" multiplier="-1" offset="0"/>
		</joint>
		<joint name="rg2_left_inner_finger_joint" type="revolute">
			<parent link="rg2_left_outer_knuckle"/>
			<child link="rg2_left_inner_finger"/>
			<origin xyz="0.039748 0.004784 0.037968" rpy="0 -0.415388362 0"/>
			<axis xyz="0 -0.999949 0.010122"/>
			<limit effort="50" lower="-1.19" upper="0.01" velocity="2"/>
			<mimic joint="rg2_finger_joint" multiplier="-1" offset="0"/>
		</joint>
		<joint name="rg2_right_inner_finger_joint" type="revolute">
			<parent link="rg2_right_outer_knuckle"/>
			<child link="rg2_right_inner_finger"/>
			<origin xyz="-0.039748 0.004784 0.037968" rpy="0 0.415388362 0"/>
			<axis xyz="0 0.999949 -0.010122"/>
			<limit effort="50" lower="-1.19" upper="0.01" velocity="2"/>
			<mimic joint="rg2_finger_joint" multiplier="-1" offset="0"/>
		</joint>
		<joint name="rg2_right_inner_knuckle_joint" type="revolute">
			<parent link="rg2_base_link"/>
			<child link="rg2_right_inner_knuckle"/>
			<origin xyz="0.01955 -0.009367 0.092397" rpy="0 -0.415388362 0"/>
			<axis xyz="0 0.999949 -0.010122"/>
			<limit effort="50" lower="-0.01" upper="1.19" velocity="2"/>
			<mimic joint="rg2_finger_joint" multiplier="1" offset="0"/>
		</joint>
		<link name="rg2_tcp"/>
		<joint name="rg2_tcp_joint" type="fixed">
			<parent link="tool0"/>
			<child link="rg2_tcp"/>
			<origin xyz="0 0 0.231066" rpy="0 0 0"/>
		</joint>


</robot>
