				</geometry>
			</visual>
			<collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="package://m0609_isaac_description/urdf/meshes/m0609_collision/MF0609_4_1.dae" scale="0.001 0.001 0.001" />
				</geometry>
			</collision>
			<visual>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="package://m0609_isaac_description/urdf/meshes/m0609_white/MF0609_4_1.dae" scale="0.001 0.001 0.001" />
				</geometry>
			</visual>
		</link>
		<!-- joint5 -->
		<joint name="joint_5" type="revolute">
			<parent link="link_4" />
			<child link="link_5" />
			<origin rpy="-1.571 0 0" xyz="0 0 0" />
			<axis xyz="0 0 1" />
			<limit effort="2700" lower="-6.2832" upper="6.2832" velocity="3.927"/>
			<dynamics friction="0"   damping="7.5" stiffness="750"/>
		</joint>
		<link name="link_5">
			<inertial>
				<mass value="2.83"/>
				<origin xyz="-6.8e-05    0.003827    0.031969"/>
				<inertia ixx="0.014275" ixy="2.2026e-05" ixz="3.3017e-06" iyy="0.012569"
					iyz="0.00045077"
					izz="0.0085318"/>
			</inertial>
            <collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
					<mesh filename="package://m0609_isaac_description/urdf/meshes/m0609_collision/MF0609_5_0.dae" scale="0.001 0.001 0.001" />
