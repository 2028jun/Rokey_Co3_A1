			<axis xyz="0 0 1" />
			<limit effort="9600" lower="-6.2832" upper="6.2832" velocity="2.618"/>
			<dynamics friction="0"  damping="26.6667" stiffness="266.6667"/>
		</joint>
		<link name="link_2">
