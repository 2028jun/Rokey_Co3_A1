			<origin rpy="1.571 0 0" xyz="0 -0.368 0" />
			<axis xyz="0 0 1" />
			<limit effort="2700" lower="-6.2832" upper="6.2832" velocity="3.927"/>
			<dynamics friction="0"  damping="7.5" stiffness="750"/>
		</joint>
		<link name="link_4">
			<inertial>
				<mass value="3.57"/>
				<origin xyz="4e-05    0.097079    -0.10981"/>
				<inertia ixx="0.08035" ixy="-4.6119e-06" ixz="-8.1798e-06" iyy="0.066005"
					iyz="-0.028996"
					izz="0.029763"/>
			</inertial>
            <collision>
				<origin rpy="0 0 0" xyz="0 0 0" />
				<geometry>
