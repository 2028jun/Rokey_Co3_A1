				</geometry>
			</visual>
		</link>
		<!-- joint6 -->
		<joint name="joint_6" type="revolute">
			<parent link="link_5" />
			<child link="link_6" />
			<origin rpy="1.571 0 0" xyz="0 -0.121 0" />
			<axis xyz="0 0 1" />
			<limit effort="2700" lower="-6.2832" upper="6.2832" velocity="3.927"/>
			<dynamics friction="0"   damping="7.5" stiffness="750"/>
		</joint>
		<link name="link_6">
			<inertial>
				<mass value="1.16"/>
				<origin xyz="-3e-05    -4.5e-05     -0.0539"/>
				<inertia ixx="0.0080226" ixy="1.371e-06" ixz="6.3578e-06" iyy="0.0053992"
					iyz="7.4676e-06"
