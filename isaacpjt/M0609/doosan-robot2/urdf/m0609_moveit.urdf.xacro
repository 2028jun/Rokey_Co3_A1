<?xml version="1.0"?>

<robot name="m0609" xmlns:xacro="http://www.ros.org/wiki/xacro">
		<link name="base_link">
			<inertial>
				<mass value="3.18"/>
				<origin xyz="-2.8e-05   -0.006045    0.038403"/>
				<inertia ixx="0.017789" ixy="-7.4356e-06" ixz="3.0378e-06" iyy="0.011135"
					iyz="-0.00029038"
					izz="0.020054"/>
