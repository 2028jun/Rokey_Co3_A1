<?xml version="1.0"?>
<robot name="ridgeback_m0609" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- The existing arm description is included as concrete links.  Its
       base_link is attached below to arm_mount_link; Ridgeback links use an
       explicit ridgeback_ prefix to keep the complete TF tree unambiguous. -->
  <xacro:include filename="$(find m0609_isaac_description)/urdf/m0609_moveit.urdf.xacro"/>

  <material name="ridgeback_black"><color rgba="0.055 0.065 0.075 1"/></material>
  <material name="ridgeback_yellow"><color rgba="0.96 0.66 0.04 1"/></material>
  <material name="ridgeback_white"><color rgba="0.90 0.93 0.95 1"/></material>
  <material name="ridgeback_red"><color rgba="0.85 0.05 0.03 1"/></material>
  <material name="shelf_steel"><color rgba="0.55 0.60 0.64 1"/></material>
  <material name="shelf_tray"><color rgba="0.16 0.24 0.30 1"/></material>

  <!-- Ridgeback dimensions and wheel placement come from Clearpath's Humble
       R100 description.  The base frame is at floor level. -->
  <xacro:property name="wheel_radius" value="0.0759"/>
  <xacro:property name="wheel_width" value="0.0790"/>
  <xacro:property name="wheel_x" value="0.319"/>
  <xacro:property name="wheel_y" value="0.2755"/>

  <link name="ridgeback_base_link">
    <visual>
      <geometry><mesh filename="package://ridgeback_m0609_description/meshes/r100/body.stl"/></geometry>
      <material name="ridgeback_black"/>
    </visual>
    <visual>
      <geometry><mesh filename="package://ridgeback_m0609_description/meshes/r100/top.stl"/></geometry>
      <material name="ridgeback_black"/>
    </visual>
    <visual>
      <geometry><mesh filename="package://ridgeback_m0609_description/meshes/r100/side_cover.stl"/></geometry>
      <material name="ridgeback_yellow"/>
    </visual>
    <visual>
      <origin rpy="0 0 ${pi}"/>
      <geometry><mesh filename="package://ridgeback_m0609_description/meshes/r100/side_cover.stl"/></geometry>
      <material name="ridgeback_yellow"/>
    </visual>
    <visual>
      <geometry><mesh filename="package://ridgeback_m0609_description/meshes/r100/end_cover.stl"/></geometry>
      <material name="ridgeback_black"/>
    </visual>
    <visual>
      <origin rpy="0 0 ${pi}"/>
      <geometry><mesh filename="package://ridgeback_m0609_description/meshes/r100/end_cover.stl"/></geometry>
      <material name="ridgeback_black"/>
    </visual>
    <visual>
      <geometry><mesh filename="package://ridgeback_m0609_description/meshes/r100/lights.stl"/></geometry>
      <material name="ridgeback_white"/>
    </visual>
    <visual>
      <origin rpy="0 0 ${pi}"/>
      <geometry><mesh filename="package://ridgeback_m0609_description/meshes/r100/lights.stl"/></geometry>
      <material name="ridgeback_red"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://ridgeback_m0609_description/meshes/r100/body_collision.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.14"/>
      <mass value="120.0"/>
      <inertia ixx="7.10" ixy="0" ixz="0" iyy="10.05" iyz="0" izz="15.55"/>
    </inertial>
  </link>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="ridgeback_base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0"/>
  </joint>

  <xacro:macro name="ridgeback_wheel" params="prefix x y">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><mesh filename="package://ridgeback_m0609_description/meshes/r100/wheel.stl"/></geometry>
        <material name="ridgeback_black"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="3.75"/>
        <inertia ixx="0.0080" ixy="0" ixz="0" iyy="0.0108" iyz="0" izz="0.0080"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="ridgeback_base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_radius}"/>
      <axis xyz="0 1 0"/>
      <limit effort="250" velocity="20"/>
      <dynamics damping="2.0" friction="0.2"/>
    </joint>
  </xacro:macro>

  <xacro:ridgeback_wheel prefix="front_left"  x="${ wheel_x}" y="${ wheel_y}"/>
  <xacro:ridgeback_wheel prefix="front_right" x="${ wheel_x}" y="${-wheel_y}"/>
  <xacro:ridgeback_wheel prefix="rear_left"   x="${-wheel_x}" y="${ wheel_y}"/>
  <xacro:ridgeback_wheel prefix="rear_right"  x="${-wheel_x}" y="${-wheel_y}"/>

  <!-- Fixed stainless shelf.  The arm is offset toward base +X so Nav2 can
       approach a service table forwards; the asymmetric tray details are
       mirrored so the pizza remains behind the arm during transport. -->
  <link name="serving_shelf_link">
    <visual>
      <origin xyz="0 0 0.44"/>
      <geometry><box size="0.74 0.62 0.025"/></geometry>
      <material name="shelf_tray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.44"/>
      <geometry><box size="0.74 0.62 0.025"/></geometry>
    </collision>
    <!-- Mirrored upper tray: retain the +X-facing service layout while the
         plate-side -X edge remains open for RG2 access from the front arm. -->
    <visual>
      <origin xyz="0 -0.145 0.64"/>
      <geometry><box size="0.74 0.33 0.025"/></geometry>
      <material name="shelf_tray"/>
    </visual>
    <collision>
      <origin xyz="0 -0.145 0.64"/>
      <geometry><box size="0.74 0.33 0.025"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.21 0.165 0.64"/>
      <geometry><box size="0.32 0.29 0.025"/></geometry>
      <material name="shelf_tray"/>
    </visual>
    <collision>
      <origin xyz="-0.21 0.165 0.64"/>
      <geometry><box size="0.32 0.29 0.025"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.84"/>
      <geometry><box size="0.74 0.62 0.030"/></geometry>
      <material name="shelf_steel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.84"/>
      <geometry><box size="0.74 0.62 0.030"/></geometry>
    </collision>

    <xacro:macro name="shelf_post" params="x y">
      <visual>
        <origin xyz="${x} ${y} 0.56"/>
        <geometry><box size="0.035 0.035 0.56"/></geometry>
        <material name="shelf_steel"/>
      </visual>
      <collision>
        <origin xyz="${x} ${y} 0.56"/>
        <geometry><box size="0.035 0.035 0.56"/></geometry>
      </collision>
    </xacro:macro>
    <xacro:shelf_post x="0.34" y="0.28"/>
    <xacro:shelf_post x="0.34" y="-0.28"/>
    <xacro:shelf_post x="-0.34" y="0.28"/>
    <xacro:shelf_post x="-0.34" y="-0.28"/>

    <visual>
      <origin xyz="0.355 0 0.56"/>
      <geometry><box size="0.025 0.58 0.54"/></geometry>
      <material name="shelf_steel"/>
    </visual>
    <collision>
      <origin xyz="0.355 0 0.56"/>
      <geometry><box size="0.025 0.58 0.54"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.03 0 0.57"/>
      <mass value="20.0"/>
      <inertia ixx="1.20" ixy="0" ixz="0" iyy="1.25" iyz="0" izz="1.50"/>
    </inertial>
  </link>
  <joint name="serving_shelf_joint" type="fixed">
    <parent link="ridgeback_base_link"/>
    <child link="serving_shelf_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <link name="arm_mount_link">
    <visual>
      <geometry><cylinder radius="0.13" length="0.035"/></geometry>
      <material name="ridgeback_yellow"/>
    </visual>
    <collision><geometry><cylinder radius="0.13" length="0.035"/></geometry></collision>
    <inertial>
      <mass value="4.0"/>
      <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.034"/>
    </inertial>
  </link>
  <joint name="arm_mount_joint" type="fixed">
    <parent link="serving_shelf_link"/>
    <child link="arm_mount_link"/>
    <origin xyz="0.22 0 0.875"/>
  </joint>

  <joint name="m0609_mount_joint" type="fixed">
    <parent link="arm_mount_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.020" rpy="0 0 0"/>
  </joint>

</robot>
