Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Class: rviz_default_plugins/Grid
      Cell Size: 1
      Name: Grid
      Plane: XY
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Map
      Name: Shared Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/map
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: /home/rokey/cobot3_ws/install/two_wheel_rails/share/two_wheel_rails/urdf/two_wheel_robot.urdf
      Description Source: File
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot1/robot_description
      Name: Robot 1
      TF Prefix: robot1
      Update Interval: 0
      Visual Enabled: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: /home/rokey/cobot3_ws/install/two_wheel_rails/share/two_wheel_rails/urdf/two_wheel_robot.urdf
      Description Source: File
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot2/robot_description
      Name: Robot 2
      TF Prefix: robot2
      Update Interval: 0
      Visual Enabled: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Color: 0; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0.5
      Name: Robot 1 Scan
      Position Transformer: XYZ
      Size (Pixels): 6
      Size (m): 0.05
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rviz/robot1/scan
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Color: 255; 128; 0
      Color Transformer: FlatColor
      Decay Time: 0.5
      Name: Robot 2 Scan
      Position Transformer: XYZ
      Size (Pixels): 6
      Size (m): 0.05
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rviz/robot2/scan
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.35
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Name: Robot 1 Local Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/robot1/local_costmap
      Use Timestamp: false
      Value: true
    - Alpha: 0.35
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Name: Robot 2 Local Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/robot2/local_costmap
      Use Timestamp: false
      Value: true
    - Alpha: 0.45
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Name: Robot 1 Global Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/robot1/global_costmap
      Use Timestamp: false
      Value: true
    - Alpha: 0.45
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Name: Robot 2 Global Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/robot2/global_costmap
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Polygon
      Color: 0; 255; 255
      Name: Robot 1 Footprint
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/robot1/local_footprint
      Value: true
    - Class: rviz_default_plugins/Polygon
      Color: 255; 128; 0
      Name: Robot 2 Footprint
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/robot2/local_footprint
      Value: true
    - Class: rviz_default_plugins/Polygon
      Color: 255; 0; 0
      Name: Robot 1 Stop Zone
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/robot1/polygon_stop
      Value: true
    - Class: rviz_default_plugins/Polygon
      Color: 255; 255; 0
      Name: Robot 1 Slowdown Zone
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/robot1/polygon_slowdown
      Value: true
    - Class: rviz_default_plugins/Polygon
      Color: 255; 0; 255
      Name: Robot 2 Stop Zone
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/robot2/polygon_stop
      Value: true
    - Class: rviz_default_plugins/Polygon
      Color: 128; 255; 0
      Name: Robot 2 Slowdown Zone
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/robot2/polygon_slowdown
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: Combined TF
      Value: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Scale: 35
Window Geometry:
  Height: 900
  Width: 1400
