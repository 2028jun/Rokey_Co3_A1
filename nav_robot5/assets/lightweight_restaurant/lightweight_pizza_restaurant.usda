#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def "Architecture"
    {
        def Cube "Floor" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.32, 0.34, 0.38)]
            double size = 1
            float3 xformOp:scale = (12, 10, 0.12)
            double3 xformOp:translate = (0, 0, -0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "KitchenFloorPatch" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            # The main floor ends at y=5.0 while both robots wait behind the
            # kitchen entrance at y=5.25. Keep visual and physical support
            # continuous across the widened doorway.
            color3f[] primvars:displayColor = [(0.32, 0.34, 0.38)]
            double size = 1
            float3 xformOp:scale = (5.0, 1.8, 0.12)
            double3 xformOp:translate = (0, 5.6, -0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "BackWallLeft" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.92, 0.89, 0.82)]
